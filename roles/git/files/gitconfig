[core]
  excludesfile = ~/.gitignore

[init]
  defaultBranch = master

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[fetch]
  prune = true

[alias]
  ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
  graph = log --all --graph --decorate --oneline

[pull]
  ff = only

[rebase]
  autoSquash = true
  autoStash = true

[rerere]
  enabled = true

[diff]
  algorithm = histogram
  colorMoved = default

[help]
  autocorrect = prompt

[push]
  autoSetupRemote = true

[commit]
  verbose = true

[branch]
  sort = -committerdate

[column]
  ui = auto

[tag]
  sort = -version:refname

[merge]
  conflictStyle = zdiff3
  tool = "nvim"

[mergetool]
  keepBackup = false
  prompt = false

[mergetool "nvim"]
  cmd = "nvim -d \"$LOCAL\" \"$MERGED\" \"$REMOTE\""

# Per-person settings (user.name, user.email, ...). This file is overwritten by
# bin/install, so identity lives in ~/.gitconfig.local instead. Keep this last
# so local values win. Silently ignored if the file doesn't exist.
[include]
  path = ~/.gitconfig.local
