#! /bin/bash
set -euxo pipefail

# Alacritty
cp ~/.config/alacritty/*.toml roles/alacritty/files/

# Bash
cp ~/.bash_profile roles/bash/files/bash_profile
cp ~/.bashrc roles/bash/files/bashrc

# Git
cp ~/.gitconfig roles/git/files/gitconfig
cp ~/.gitignore roles/git/files/gitignore
cp ~/.config/gh/config.yml roles/git/files/gh-config.yml
# cp ~/.tigrc roles/git/files/tigrc

# Tmux
cp ~/.tmux.conf roles/tmux/files/tmux.conf

# nVim
cp ~/.config/nvim/* roles/nvim/files/
cp ~/.config/nvim/.* roles/nvim/files/

# Claude
cp ~/.config/claude/CLAUDE.md roles/claude/files/CLAUDE.md
for profile in roles/claude/files/profiles/*/; do
  name="$(basename "$profile")"
  cp ~/.config/claude/"$name"/CLAUDE.md "$profile"CLAUDE.md
done
